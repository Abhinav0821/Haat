# ── PayPal (sandbox) ─────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → (Sandbox) → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" or "live". Keep sandbox for the hackathon.
PAYPAL_ENV=sandbox
# Filled in on Day 3 (Webhooks section of your PayPal app)
PAYPAL_WEBHOOK_ID=

# ── AI model ─────────────────────────────────────────────────────
# "google" (default, free tier) or "openai" (OpenAI or any OpenAI-compatible gateway)
AI_PROVIDER=google
# aistudio.google.com → Get API key (free, no card)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash
# Tried in order if the primary model is overloaded or rate-limited (each has its own free quota)
GOOGLE_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-3.1-flash-lite

# Only if AI_PROVIDER=openai
OPENAI_API_KEY=
# Exact model id your key can access (the smoke test lists them if wrong)
OPENAI_MODEL=gpt-5-mini
# Only for OpenAI-compatible gateways. Keys starting with sk-or- are auto-detected as OpenRouter.
OPENAI_BASE_URL=

# ── Database ─────────────────────────────────────────────────────
# Leave empty locally: an embedded Postgres (PGlite) is stored in ./.data
# Production: a Postgres URL. On Vercel use Neon's POOLED connection string (host contains "-pooler").
DATABASE_URL=
# Optional: max connections per server instance (default 5; 1–3 suits serverless)
DB_POOL_MAX=

# ── App ──────────────────────────────────────────────────────────
# Public URL (PayPal return/cancel links). On Vercel it defaults to the production domain.
APP_URL=http://localhost:3000
# Estimated rupees per dollar, used for labelled estimates shown to the maker
INR_PER_USD=88

# ── Optional: fair-price coach (comparable products) ─────────────
# channel3.ai → API key. Without it the coach is skipped.
CHANNEL3_API_KEY=

# ── Seller studio ────────────────────────────────────────────────
# PIN that unlocks /seller (listing, inbox, refunds). Required — without it the seller area stays locked.
SELLER_PASSCODE=
# Optional: secret for signing seller session cookies (defaults to one derived from the passcode).
SESSION_SECRET=
